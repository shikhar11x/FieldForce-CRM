generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  NEW
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
}

enum VisitType {
  SALES
  SERVICE
  FOLLOW_UP
  DELIVERY
  DEMO
}

enum VisitEventType {
  SCHEDULED
  STARTED
  QR_VERIFIED
  NOTE
  PHOTO
  COMPLETED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  teams     Team[]
  customers Customer[]
  tasks     Task[]
  visits    Visit[]

  @@map("organizations")
}

model Team {
  id             String @id @default(uuid())
  organizationId String
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]

  @@unique([organizationId, name])
  @@map("teams")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  name           String
  email          String   @unique
  phone          String
  passwordHash   String
  role           Role
  designation    String
  department     String
  teamId         String?
  managerId      String?
  joiningDate    DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team              Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager           User?          @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           User[]         @relation("ManagerReports")
  refreshTokens     RefreshToken[]
  assignedCustomers Customer[]     @relation("AssignedCustomers")
  customerNotes     CustomerNote[]
  assignedTasks     Task[]         @relation("AssignedTasks")
  createdTasks      Task[]         @relation("CreatedTasks")
  assignedVisits    Visit[]        @relation("AssignedVisits")
  createdVisits     Visit[]        @relation("CreatedVisits")
  visitNotes        VisitNote[]

  @@index([organizationId, role])
  @@index([managerId])
  @@map("users")
}

/// Sirf refresh token ka hash store hota hai, token khud nahi.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  company        String
  contactName    String
  phone          String
  email          String
  address        String
  status         CustomerStatus @default(NEW)
  highPriority   Boolean        @default(false)
  assignedToId   String?
  lastVisitAt    DateTime?
  nextVisitAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedCustomers", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        CustomerNote[]
  tasks        Task[]
  visits       Visit[]

  @@index([organizationId, status])
  @@index([assignedToId])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String       @default("")
  customerId     String
  assignedToId   String
  createdById    String
  dueAt          DateTime
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  location       String       @default("")
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo   User         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([dueAt])
  @@map("tasks")
}

model Visit {
  id             String      @id @default(uuid())
  organizationId String
  customerId     String
  assignedToId   String
  createdById    String
  scheduledAt    DateTime
  location       String      @default("")
  status         VisitStatus @default(SCHEDULED)
  type           VisitType
  purpose        String
  qrVerified     Boolean     @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo   User               @relation("AssignedVisits", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("CreatedVisits", fields: [createdById], references: [id], onDelete: Restrict)
  notes        VisitNote[]
  attachments  VisitAttachment[]
  events       VisitEvent[]

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([scheduledAt])
  @@map("visits")
}

model VisitNote {
  id        String   @id @default(uuid())
  visitId   String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  visit  Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([visitId, createdAt])
  @@map("visit_notes")
}

/// Abhi sirf placeholder metadata. Asli file upload baad ke step me aayega.
model VisitAttachment {
  id         String   @id @default(uuid())
  visitId    String
  name       String
  kind       String
  size       String
  uploadedAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_attachments")
}

model VisitEvent {
  id        String         @id @default(uuid())
  visitId   String
  type      VisitEventType
  title     String
  createdAt DateTime       @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
  @@map("visit_events")
}