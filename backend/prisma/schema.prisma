generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
  teams Team[]

  @@map("organizations")
}

model Team {
  id             String @id @default(uuid())
  organizationId String
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]

  @@unique([organizationId, name])
  @@map("teams")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  name           String
  email          String   @unique
  phone          String
  passwordHash   String
  role           Role
  designation    String
  department     String
  teamId         String?
  managerId      String?
  joiningDate    DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager       User?          @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]         @relation("ManagerReports")
  refreshTokens RefreshToken[]

  @@index([organizationId, role])
  @@index([managerId])
  @@map("users")
}

/// Sirf refresh token ka hash store hota hai, token khud nahi.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}